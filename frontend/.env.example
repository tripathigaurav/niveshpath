# API base URL (no trailing slash). Vite dev proxies /api → localhost:5000 by default.
# Optional dev port (default 5199; Vite uses next free port if taken):
# VITE_DEV_PORT=5199
# For GitHub Pages or other static hosting, point to your deployed Flask backend:
# VITE_API_BASE=https://your-backend.example.com/api

VITE_API_BASE=/api
